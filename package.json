{
  "name": "kioskshell",
  "version": "1.1.6",
  "description": "KIOCAST KioskShell - secure touch kiosk browser",
  "author": "SignCast Design",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.kioskshell.app",
    "productName": "KioskShell",
    "artifactName": "KIOCAST KioskShell Setup ${version}-${arch}.${ext}",
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KIOCAST KioskShell",
      "menuCategory": "KIOCAST",
      "uninstallDisplayName": "KIOCAST KioskShell",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "signcastdesign",
        "repo": "kiocast-kioskmode"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
